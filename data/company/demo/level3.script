var game ;
var uidrich ;
 
function initMap() {
  game = new Game() ;
  game.setSeed(76531816) ;

  // Обязательный вызов инициализации системы событий
  initEvents() ;

  addEvent(function() { return game.getUnitHealth(uidrich)<3000 },
    function() {
      game.setNewViewPoint(37,37) ;
      game.addMessage("unicorn",10,"$Brief_Alert") ;
      game.addEnemy1(35,35) ;
      game.addEnemy1(39,35) ;
      game.addEnemy1(35,39) ;
      game.addEnemy1(39,39) ;
    }) ;

  if (game.isHard1()) {
  addEvent(function() { return game.getUnitHealth(uidrich)<2000 },
    function() {
      game.setNewViewPoint(37,37) ;
      game.addEnemy1(35,35) ;
      game.addEnemy1(39,35) ;
      game.addEnemy2(35,39) ;
      game.addEnemy2(39,39) ;
    }) ;
  }

  if (game.isHard2()) {
  addEvent(function() { return game.getUnitHealth(uidrich)<1000 },
    function() {
      game.setNewViewPoint(37,37) ;
      game.addEnemy3(35,35) ;
      game.addEnemy3(39,35) ;
      game.addEnemy2(35,39) ;
      game.addEnemy2(39,39) ;
    }) ;
  }

  game.allowAction("MakeHarvester") ;
  game.allowAction("MakeAttacker") ;
  game.allowAction("MakeHealer") ;
  game.allowAction("MakeRadar") ;
  game.allowAction("DoRadar") ;
  game.allowAction("UpgradeHarvester") ;
  game.allowAction("UpgradeAttacker") ;
  game.allowAction("UpgradeHealer") ;
  game.allowAction("MakeShield") ;
  game.allowAction("DoShield") ;
  game.allowAction("MakeTowerAttack") ;
  game.allowAction("MakeTowerHealer") ;
  game.allowAction("MakeTowerHarvest") ;
  game.allowAction("BuildUnicorn") ;
  game.allowAction("ResearchWorkInAction") ;
  game.allowAction("ResearchWorkInMoving") ;
  game.allowAction("ResearchMagicEconomy") ;
  game.allowAction("ResearchLongDist") ;
  game.allowAction("ConstructMachine") ;
  game.allowAction("UpgradePortal") ;
  game.allowAction("BuildHouse") ;
  game.allowAction("BuildStore") ;
  game.allowAction("BuildAcademy") ;
  game.allowAction("BuildMachinary") ;
  game.allowAction("SetupBaseShield") ;

  game.addPortal(13,32) ;
  game.clearFogAt(13,32,7) ;
  game.clearFogAt(37,37,7) ;
  game.clearFogAt(13,9,7) ;

  uidrich = game.addCrystalRich(37,37,4000) ;
  game.addLair(10,6,"6a") ;
  game.addLair(39,41,"5a5a5b") ;
  if (game.isHard1()) {
    game.addLair(42,3,"4a4a4a4b4b4c4c") ;
  }

  game.incEnergy(190) ;

  game.setNewViewPoint(37,39) ;

  game.addMessage("unicorn",10,"$Brief_1_1") ;

  game.addNewTask("rich","$MainTask") ;
  if (game.isHard2()) {
    game.addNewTask("amount","$ManaTask") ;
  }
  game.addNewTask("caves","$SecondTask") ;

  return true ;
}

function Update() {
  processEvents() ;

  if ((game.getCountByComponent("EnemyLair")==0)&&
     (!game.isFlag("nocaves"))) {
     game.setFlag("nocaves") ;
     game.setTaskCompleted("caves") ;
     game.addMessage("unicorn",10,"$Brief_2") ;
  }

  if ((!game.isUnitExist(uidrich))&&(!game.isFlag("rich"))) {
     game.setFlag("rich") ;
     if (game.isHard2()) {
       if (game.getEnergy()>=5000) {
         game.setFlag("win") ;
         game.addMessage("unicorn",10,"$Brief_3_Win") ;
       }
       else {
         game.setFlag("fail") ;
         game.addMessage("unicorn",10,"$Brief_3_Fail") ;
       }
     }
     else {
       game.setFlag("win") ;
       game.addMessage("unicorn",10,"$Brief_3") ;
     }
  }
}

function isVictory() {
  return game.isFlag("win") ;
}

function isDefeat() {
  if ((game.getCountByComponent("Unicorn")==0)&&
      (game.getCountByComponent("Portal")==0)) { return true ; }
  if (game.isFlag("fail")) { return true ; }
  return false ;
}
